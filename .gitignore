# Secrets: Wi-Fi SSID/password and ThingSpeak write key. Copy app_secrets.h.template.
Core/Inc/app_secrets.h
# Host-side ThingSpeak values (channel ID, read key) for checking uploads. Copy the .template.
tools/thingspeak_host.env

# Build output (one folder per build configuration)
Debug/
Release/
Debug-Trace/
build/

# Compiled files
*.elf
*.hex
*.bin
*.map
*.list
*.o
*.su
*.d
*.cyclo

# STM32CubeIDE: launch files and per-machine state, recreated on import
*.launch
.settings/language.settings.xml
.metadata/

# STM32CubeMX backup of the .ioc
*.ioc.bak

# Trace captures (raw ring dumps; decoded results that belong in the docs go to docs/results/)
ring.bin

# Editors and OS
.vscode/
.cache/
.clangd
compile_commands.json
.DS_Store
Thumbs.db
