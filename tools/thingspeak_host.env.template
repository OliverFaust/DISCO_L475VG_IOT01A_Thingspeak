# thingspeak_host.env.template -- copy to tools/thingspeak_host.env (same folder) and fill in.
#
#   cp tools/thingspeak_host.env.template tools/thingspeak_host.env
#
# Values for checking uploads from the PC (reading the channel feed with curl). The firmware never
# sees this file; its own secrets (Wi-Fi, write key) are in Core/Inc/app_secrets.h.
# tools/thingspeak_host.env is listed in .gitignore and must never be committed.
#
# THINGSPEAK_CHANNEL_ID: the channel's number (Channel Settings, "Channel ID").
# THINGSPEAK_READ_KEY:   the channel's Read API Key (API Keys tab). Leave it empty for a public channel.
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_KEY=
